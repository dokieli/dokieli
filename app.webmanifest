{
  "name": "dokieli",
  "short_name": "dokieli",
  "description": "Clientside editor for decentralised article publishing, annotations, and social interactions.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#19a000",
  "icons": [
    { "src": "/media/images/dokieli-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/media/images/dokieli-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "shortcuts": [
    { "name": "New document", "url": "/new" },
    { "name": "Open", "url": "/?open" },
    { "name": "Notifications", "url": "/?inbox" }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": { "url": "url", "text": "text", "title": "title" }
  }
}
